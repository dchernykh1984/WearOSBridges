{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/check_ascii.py\""
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(./gradlew ktlintCheck:*)",
      "Bash(./gradlew detekt:*)",
      "Bash(./gradlew testDebugUnitTest:*)",
      "Bash(./gradlew koverVerify:*)",
      "Bash(./gradlew lintDebug:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(git show:*)",
      "Bash(git fetch:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr list:*)",
      "Bash(gh run view:*)"
    ]
  }
}
